# claude-bridge — required for the Next.js web app.
# Copy to .env.local for local dev. Set the same values in your hosting
# provider's env panel (Netlify / Vercel / Render / etc.) for production.

# Postgres connection string. Tested with Neon (https://neon.tech), but any
# Postgres 13+ that supports `gen_random_uuid()` works.
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Random string ≥16 chars. The admin UI at /admin/claude-bot is gated behind
# this — anyone with this token can sign in and send prompts on your behalf.
# Generate with:  openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-long-random-string

# Shared secret between this web app and the bridge process running on your
# home machine (the program that runs `claude --print` and posts the response
# back). Both sides must have the same value. Generate with: openssl rand -hex 32
BRIDGE_SECRET=replace-with-a-long-random-string

# Public URL of the bridge — typically a Cloudflare Tunnel / ngrok URL that
# forwards to the bridge's :7777 port. If unset, the web app skips the fast
# push path and the bridge falls back to its slower polling loop.
BRIDGE_PUSH_URL=https://your-tunnel.example.com

# Shared secret for external apps that submit prompts via /api/external/prompt
# (and for QA-extension callers via /api/qa-assistant). Different from
# BRIDGE_SECRET so you can rotate them independently.
EXTERNAL_API_SECRET=replace-with-a-long-random-string

# Cron secret for /api/cron/scheduled-tasks. Set the same value in whatever
# external scheduler you use (e.g. cron-job.org, Cloudflare Workers cron).
# Hit it with ?secret=... or Authorization: Bearer ...
CRON_SECRET=replace-with-a-long-random-string

# Optional: default timezone for scheduled-task time-of-day (e.g. "America/Los_Angeles").
# Defaults to "UTC" if unset. Each task can override via the timezone column.
# DEFAULT_TIMEZONE=UTC

# Optional: default workspace for QA-extension reports if the extension didn't
# include one. Useful when the extension only ever targets one project.
# QA_DEFAULT_WORKSPACE=my-app
