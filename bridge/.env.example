# Local-machine bridge — required environment.

# Same value you set as BRIDGE_SECRET in the deployed web app.
BRIDGE_SECRET=replace-with-the-same-value-as-the-web-app

# Public URL of the deployed web app (Netlify / Vercel / whatever).
WEB_APP_URL=https://your-claude-bridge-deployment.example.com

# Comma-separated list of base directories where your workspace folders live.
# When the web app sends `workspace=my-app`, the bridge looks for `my-app`
# inside each base in order. Falls back to creating it under the first base
# if not found.
PROJECT_DIRS=C:\projects

# --- Optional ---

# Local port the bridge listens on. Default 7777.
# BRIDGE_PORT=7777

# Path to the claude binary if it's not on PATH (e.g. "/usr/local/bin/claude").
# CLAUDE_CLI_PATH=claude

# Set to "false" to skip the one-shot startup catchup pass.
# BRIDGE_CATCHUP=true

# Set to "false" to skip the best-effort `git pull --ff-only` this runs in a
# workspace before every prompt (default: on). Without it, a workspace is
# only ever as fresh as the last time someone manually pulled it there, and
# Claude can end up drafting/triaging against stale code.
# BRIDGE_GIT_SYNC=true
